{
  "packages": {
    "@ix/jcs": {
      "dir": "packages/jcs",
      "layer": "core",
      "dependsOn": []
    },
    "@ix/config": {
      "dir": "packages/config",
      "layer": "core",
      "dependsOn": []
    },
    "@ix/identity": {
      "dir": "packages/identity",
      "layer": "core",
      "dependsOn": []
    },
    "@ix/protocol-core": {
      "dir": "packages/protocol-core",
      "layer": "core",
      "dependsOn": []
    },
    "@ix/distribution": {
      "dir": "packages/distribution",
      "layer": "core",
      "dependsOn": []
    },
    "@ix/log": {
      "dir": "packages/log",
      "layer": "core",
      "dependsOn": []
    },
    "@ix/a2a-ext-mandate": {
      "dir": "packages/a2a-ext-mandate",
      "layer": "core",
      "dependsOn": ["@ix/protocol-core"]
    },
    "@ix/a2a-ext-approval": {
      "dir": "packages/a2a-ext-approval",
      "layer": "core",
      "dependsOn": ["@ix/protocol-core"]
    },
    "@ix/a2a-ext-transcript": {
      "dir": "packages/a2a-ext-transcript",
      "layer": "core",
      "dependsOn": ["@ix/protocol-core"]
    },
    "@ix/a2a-ext-negotiation": {
      "dir": "packages/a2a-ext-negotiation",
      "layer": "core",
      "dependsOn": [
