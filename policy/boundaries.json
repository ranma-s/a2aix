    "@ix/approval-app": {
      "dir": "packages/approval-app",
      "layer": "app",
      "dependsOn": ["@ix/identity"]
    },
    "@ix/conformance": {
      "dir": "packages/conformance",
      "layer": "suite",
      "dependsOn": [
        "@ix/agents",
        "@ix/approval-app",
        "@ix/distribution",
        "@ix/node",
        "@ix/protocol-core",
        "@ix/verify"
      ]
    },
    "@ix/adapters": {
      "dir": "packages/adapters",
      "layer": "adapter",
      "dependsOn": ["@ix/agents", "@ix/config", "@ix/distribution", "@ix/node"]
    }
