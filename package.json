{
  "name": "ix",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "guardrails": "node scripts/prove-guardrails.mjs",
    "test": "vitest run",
    "conformance": "vitest run --config vitest.conformance.config.ts",
    "job:check": "node --test scripts/ix-job.test.mjs",
    "bridge:check": "python3 -m unittest discover -s automation/bridge -p 'test_*.py'",
    "check": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm guardrails && pnpm test && pnpm conformance && pnpm job:check && pnpm bridge:check",
    "verify": "node scripts/verify-ix-node.mjs drive"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ix/adapters": "workspace:*",
    "@ix/agents": "workspace:*",
    "@ix/jcs": "workspace:*",
    "@ix/verify": "workspace:*",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
